# =============================================================================
# SecureGraph - Root .gitignore
# =============================================================================

# Variables de entorno y secretos locales
.env
.env.local
.env.*.local

# Backend (Java / Maven / Spring Boot)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/mvnw.cmd.bak
*.class
*.log
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Frontend (Angular / Node / TypeScript)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDEs y Editores
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# Sistema Operativo
.DS_Store
Thumbs.db

# Volúmenes locales de Docker
postgres_data/

