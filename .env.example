# Configuración de Base de Datos PostgreSQL 16
POSTGRES_DB=securegraph_db
POSTGRES_USER=securegraph_user
POSTGRES_PASSWORD=securegraph_pass
POSTGRES_PORT=5432

# Configuración del Backend (Spring Boot)
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securegraph_db
SPRING_DATASOURCE_USERNAME=securegraph_user
SPRING_DATASOURCE_PASSWORD=securegraph_pass
OSV_API_BASE_URL=https://api.osv.dev/v1
CORS_ALLOWED_ORIGINS=http://localhost:4200

